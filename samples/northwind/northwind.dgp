  DataDictionary.Categories = <
    item
      CategoryType = ctProcedure
      Objects = <
        item
          ObjectName = 'CustOrderHist'
          CreateImplementation = 
            'CREATE PROCEDURE CustOrderHist @CustomerID nchar(5)'#13#10'AS'#13#10'SELECT ' +
            'ProductName, Total=SUM(Quantity)'#13#10'FROM Products P, [Order Detail' +
            's] OD, Orders O, Customers C'#13#10'WHERE C.CustomerID = @CustomerID'#13#10 +
            'AND C.CustomerID = O.CustomerID AND O.OrderID = OD.OrderID AND O' +
            'D.ProductID = P.ProductID'#13#10'GROUP BY ProductName'#13#10
        end
        item
          ObjectName = 'CustOrdersDetail'
          CreateImplementation = 
            #13#10'CREATE PROCEDURE CustOrdersDetail @OrderID int'#13#10'AS'#13#10'SELECT Pro' +
            'ductName,'#13#10'    UnitPrice=ROUND(Od.UnitPrice, 2),'#13#10'    Quantity,'#13 +
            #10'    Discount=CONVERT(int, Discount * 100), '#13#10'    ExtendedPrice=' +
            'ROUND(CONVERT(money, Quantity * (1 - Discount) * Od.UnitPrice), ' +
            '2)'#13#10'FROM Products P, [Order Details] Od'#13#10'WHERE Od.ProductID = P.' +
            'ProductID and Od.OrderID = @OrderID'#13#10
        end
        item
          ObjectName = 'CustOrdersOrders'
          CreateImplementation = 
            #13#10'CREATE PROCEDURE CustOrdersOrders @CustomerID nchar(5)'#13#10'AS'#13#10'SE' +
            'LECT OrderID, '#13#10#9'OrderDate,'#13#10#9'RequiredDate,'#13#10#9'ShippedDate'#13#10'FROM ' +
            'Orders'#13#10'WHERE CustomerID = @CustomerID'#13#10'ORDER BY OrderID'#13#10
        end
        item
          ObjectName = 'Employee Sales by Country'
          CreateImplementation = 
            #13#10'create procedure "Employee Sales by Country" '#13#10'@Beginning_Date' +
            ' DateTime, @Ending_Date DateTime AS'#13#10'SELECT Employees.Country, E' +
            'mployees.LastName, Employees.FirstName, Orders.ShippedDate, Orde' +
            'rs.OrderID, "Order Subtotals".Subtotal AS SaleAmount'#13#10'FROM Emplo' +
            'yees INNER JOIN '#13#10#9'(Orders INNER JOIN "Order Subtotals" ON Order' +
            's.OrderID = "Order Subtotals".OrderID) '#13#10#9'ON Employees.EmployeeI' +
            'D = Orders.EmployeeID'#13#10'WHERE Orders.ShippedDate Between @Beginni' +
            'ng_Date And @Ending_Date'#13#10
        end
        item
          ObjectName = 'Sales by Year'
          CreateImplementation = 
            #13#10'create procedure "Sales by Year" '#13#10#9'@Beginning_Date DateTime, ' +
            '@Ending_Date DateTime AS'#13#10'SELECT Orders.ShippedDate, Orders.Orde' +
            'rID, "Order Subtotals".Subtotal, DATENAME(yy,ShippedDate) AS Yea' +
            'r'#13#10'FROM Orders INNER JOIN "Order Subtotals" ON Orders.OrderID = ' +
            '"Order Subtotals".OrderID'#13#10'WHERE Orders.ShippedDate Between @Beg' +
            'inning_Date And @Ending_Date'#13#10
        end
        item
          ObjectName = 'SalesByCategory'
          CreateImplementation = 
            'CREATE PROCEDURE SalesByCategory'#13#10'    @CategoryName nvarchar(15)' +
            ', @OrdYear nvarchar(4) = '#39'1998'#39#13#10'AS'#13#10'IF @OrdYear != '#39'1996'#39' AND @' +
            'OrdYear != '#39'1997'#39' AND @OrdYear != '#39'1998'#39' '#13#10'BEGIN'#13#10#9'SELECT @OrdYe' +
            'ar = '#39'1998'#39#13#10'END'#13#10#13#10'SELECT ProductName,'#13#10#9'TotalPurchase=ROUND(SU' +
            'M(CONVERT(decimal(14,2), OD.Quantity * (1-OD.Discount) * OD.Unit' +
            'Price)), 0)'#13#10'FROM [Order Details] OD, Orders O, Products P, Cate' +
            'gories C'#13#10'WHERE OD.OrderID = O.OrderID '#13#10#9'AND OD.ProductID = P.P' +
            'roductID '#13#10#9'AND P.CategoryID = C.CategoryID'#13#10#9'AND C.CategoryName' +
            ' = @CategoryName'#13#10#9'AND SUBSTRING(CONVERT(nvarchar(22), O.OrderDa' +
            'te, 111), 1, 4) = @OrdYear'#13#10'GROUP BY ProductName'#13#10'ORDER BY Produ' +
            'ctName'#13#10
        end
        item
          ObjectName = 'Ten Most Expensive Products'
          CreateImplementation = 
            #13#10'create procedure "Ten Most Expensive Products" AS'#13#10'SET ROWCOUN' +
            'T 10'#13#10'SELECT Products.ProductName AS TenMostExpensiveProducts, P' +
            'roducts.UnitPrice'#13#10'FROM Products'#13#10'ORDER BY Products.UnitPrice DE' +
            'SC'#13#10
        end>
    end
    item
      CategoryType = ctView
      Objects = <
        item
          ObjectName = 'Alphabetical list of products'
          CreateImplementation = 
            #13#10'create view "Alphabetical list of products" AS'#13#10'SELECT Product' +
            's.*, Categories.CategoryName'#13#10'FROM Categories INNER JOIN Product' +
            's ON Categories.CategoryID = Products.CategoryID'#13#10'WHERE (((Produ' +
            'cts.Discontinued)=0))'#13#10
        end
        item
          ObjectName = 'Category Sales for 1997'
          CreateImplementation = 
            #13#10'create view "Category Sales for 1997" AS'#13#10'SELECT "Product Sale' +
            's for 1997".CategoryName, Sum("Product Sales for 1997".ProductSa' +
            'les) AS CategorySales'#13#10'FROM "Product Sales for 1997"'#13#10'GROUP BY "' +
            'Product Sales for 1997".CategoryName'#13#10
        end
        item
          ObjectName = 'Current Product List'
          CreateImplementation = 
            #13#10'create view "Current Product List" AS'#13#10'SELECT Product_List.Pro' +
            'ductID, Product_List.ProductName'#13#10'FROM Products AS Product_List'#13 +
            #10'WHERE (((Product_List.Discontinued)=0))'#13#10'--ORDER BY Product_Lis' +
            't.ProductName'#13#10
        end
        item
          ObjectName = 'Customer and Suppliers by City'
          CreateImplementation = 
            #13#10'create view "Customer and Suppliers by City" AS'#13#10'SELECT City, ' +
            'CompanyName, ContactName, '#39'Customers'#39' AS Relationship '#13#10'FROM Cus' +
            'tomers'#13#10'UNION SELECT City, CompanyName, ContactName, '#39'Suppliers'#39 +
            #13#10'FROM Suppliers'#13#10'--ORDER BY City, CompanyName'#13#10
        end
        item
          ObjectName = 'Invoices'
          CreateImplementation = 
            #13#10'create view Invoices AS'#13#10'SELECT Orders.ShipName, Orders.ShipAd' +
            'dress, Orders.ShipCity, Orders.ShipRegion, Orders.ShipPostalCode' +
            ', '#13#10#9'Orders.ShipCountry, Orders.CustomerID, Customers.CompanyNam' +
            'e AS CustomerName, Customers.Address, Customers.City, '#13#10#9'Custome' +
            'rs.Region, Customers.PostalCode, Customers.Country, '#13#10#9'(FirstNam' +
            'e + '#39' '#39' + LastName) AS Salesperson, '#13#10#9'Orders.OrderID, Orders.Or' +
            'derDate, Orders.RequiredDate, Orders.ShippedDate, Shippers.Compa' +
            'nyName As ShipperName, '#13#10#9'"Order Details".ProductID, Products.Pr' +
            'oductName, "Order Details".UnitPrice, "Order Details".Quantity, ' +
            #13#10#9'"Order Details".Discount, '#13#10#9'(CONVERT(money,("Order Details".' +
            'UnitPrice*Quantity*(1-Discount)/100))*100) AS ExtendedPrice, Ord' +
            'ers.Freight'#13#10'FROM '#9'Shippers INNER JOIN '#13#10#9#9'(Products INNER JOIN ' +
            #13#10#9#9#9'('#13#10#9#9#9#9'(Employees INNER JOIN '#13#10#9#9#9#9#9'(Customers INNER JOIN O' +
            'rders ON Customers.CustomerID = Orders.CustomerID) '#13#10#9#9#9#9'ON Empl' +
            'oyees.EmployeeID = Orders.EmployeeID) '#13#10#9#9#9'INNER JOIN "Order Det' +
            'ails" ON Orders.OrderID = "Order Details".OrderID) '#13#10#9#9'ON Produc' +
            'ts.ProductID = "Order Details".ProductID) '#13#10#9'ON Shippers.Shipper' +
            'ID = Orders.ShipVia'#13#10
        end
        item
          ObjectName = 'Order Details Extended'
          CreateImplementation = 
            #13#10'create view "Order Details Extended" AS'#13#10'SELECT "Order Details' +
            '".OrderID, "Order Details".ProductID, Products.ProductName, '#13#10#9'"' +
            'Order Details".UnitPrice, "Order Details".Quantity, "Order Detai' +
            'ls".Discount, '#13#10#9'(CONVERT(money,("Order Details".UnitPrice*Quant' +
            'ity*(1-Discount)/100))*100) AS ExtendedPrice'#13#10'FROM Products INNE' +
            'R JOIN "Order Details" ON Products.ProductID = "Order Details".P' +
            'roductID'#13#10'--ORDER BY "Order Details".OrderID'#13#10
        end
        item
          ObjectName = 'Order Subtotals'
          CreateImplementation = 
            #13#10'create view "Order Subtotals" AS'#13#10'SELECT "Order Details".Order' +
            'ID, Sum(CONVERT(money,("Order Details".UnitPrice*Quantity*(1-Dis' +
            'count)/100))*100) AS Subtotal'#13#10'FROM "Order Details"'#13#10'GROUP BY "O' +
            'rder Details".OrderID'#13#10
        end
        item
          ObjectName = 'Orders Qry'
          CreateImplementation = 
            #13#10'create view "Orders Qry" AS'#13#10'SELECT Orders.OrderID, Orders.Cus' +
            'tomerID, Orders.EmployeeID, Orders.OrderDate, Orders.RequiredDat' +
            'e, '#13#10#9'Orders.ShippedDate, Orders.ShipVia, Orders.Freight, Orders' +
            '.ShipName, Orders.ShipAddress, Orders.ShipCity, '#13#10#9'Orders.ShipRe' +
            'gion, Orders.ShipPostalCode, Orders.ShipCountry, '#13#10#9'Customers.Co' +
            'mpanyName, Customers.Address, Customers.City, Customers.Region, ' +
            'Customers.PostalCode, Customers.Country'#13#10'FROM Customers INNER JO' +
            'IN Orders ON Customers.CustomerID = Orders.CustomerID'#13#10
        end
        item
          ObjectName = 'Product Sales for 1997'
          CreateImplementation = 
            #13#10'create view "Product Sales for 1997" AS'#13#10'SELECT Categories.Cat' +
            'egoryName, Products.ProductName, '#13#10'Sum(CONVERT(money,("Order Det' +
            'ails".UnitPrice*Quantity*(1-Discount)/100))*100) AS ProductSales' +
            #13#10'FROM (Categories INNER JOIN Products ON Categories.CategoryID ' +
            '= Products.CategoryID) '#13#10#9'INNER JOIN (Orders '#13#10#9#9'INNER JOIN "Ord' +
            'er Details" ON Orders.OrderID = "Order Details".OrderID) '#13#10#9'ON P' +
            'roducts.ProductID = "Order Details".ProductID'#13#10'WHERE (((Orders.S' +
            'hippedDate) Between '#39'19970101'#39' And '#39'19971231'#39'))'#13#10'GROUP BY Catego' +
            'ries.CategoryName, Products.ProductName'#13#10
        end
        item
          ObjectName = 'Products Above Average Price'
          CreateImplementation = 
            #13#10'create view "Products Above Average Price" AS'#13#10'SELECT Products' +
            '.ProductName, Products.UnitPrice'#13#10'FROM Products'#13#10'WHERE Products.' +
            'UnitPrice>(SELECT AVG(UnitPrice) From Products)'#13#10'--ORDER BY Prod' +
            'ucts.UnitPrice DESC'#13#10
        end
        item
          ObjectName = 'Products by Category'
          CreateImplementation = 
            #13#10'create view "Products by Category" AS'#13#10'SELECT Categories.Categ' +
            'oryName, Products.ProductName, Products.QuantityPerUnit, Product' +
            's.UnitsInStock, Products.Discontinued'#13#10'FROM Categories INNER JOI' +
            'N Products ON Categories.CategoryID = Products.CategoryID'#13#10'WHERE' +
            ' Products.Discontinued <> 1'#13#10'--ORDER BY Categories.CategoryName,' +
            ' Products.ProductName'#13#10
        end
        item
          ObjectName = 'Quarterly Orders'
          CreateImplementation = 
            #13#10'create view "Quarterly Orders" AS'#13#10'SELECT DISTINCT Customers.C' +
            'ustomerID, Customers.CompanyName, Customers.City, Customers.Coun' +
            'try'#13#10'FROM Customers RIGHT JOIN Orders ON Customers.CustomerID = ' +
            'Orders.CustomerID'#13#10'WHERE Orders.OrderDate BETWEEN '#39'19970101'#39' And' +
            ' '#39'19971231'#39#13#10
        end
        item
          ObjectName = 'Sales by Category'
          CreateImplementation = 
            #13#10'create view "Sales by Category" AS'#13#10'SELECT Categories.Category' +
            'ID, Categories.CategoryName, Products.ProductName, '#13#10#9'Sum("Order' +
            ' Details Extended".ExtendedPrice) AS ProductSales'#13#10'FROM '#9'Categor' +
            'ies INNER JOIN '#13#10#9#9'(Products INNER JOIN '#13#10#9#9#9'(Orders INNER JOIN ' +
            '"Order Details Extended" ON Orders.OrderID = "Order Details Exte' +
            'nded".OrderID) '#13#10#9#9'ON Products.ProductID = "Order Details Extend' +
            'ed".ProductID) '#13#10#9'ON Categories.CategoryID = Products.CategoryID' +
            #13#10'WHERE Orders.OrderDate BETWEEN '#39'19970101'#39' And '#39'19971231'#39#13#10'GROU' +
            'P BY Categories.CategoryID, Categories.CategoryName, Products.Pr' +
            'oductName'#13#10'--ORDER BY Products.ProductName'#13#10
        end
        item
          ObjectName = 'Sales Totals by Amount'
          CreateImplementation = 
            #13#10'create view "Sales Totals by Amount" AS'#13#10'SELECT "Order Subtota' +
            'ls".Subtotal AS SaleAmount, Orders.OrderID, Customers.CompanyNam' +
            'e, Orders.ShippedDate'#13#10'FROM '#9'Customers INNER JOIN '#13#10#9#9'(Orders IN' +
            'NER JOIN "Order Subtotals" ON Orders.OrderID = "Order Subtotals"' +
            '.OrderID) '#13#10#9'ON Customers.CustomerID = Orders.CustomerID'#13#10'WHERE ' +
            '("Order Subtotals".Subtotal >2500) AND (Orders.ShippedDate BETWE' +
            'EN '#39'19970101'#39' And '#39'19971231'#39')'#13#10
        end
        item
          ObjectName = 'Summary of Sales by Quarter'
          CreateImplementation = 
            #13#10'create view "Summary of Sales by Quarter" AS'#13#10'SELECT Orders.Sh' +
            'ippedDate, Orders.OrderID, "Order Subtotals".Subtotal'#13#10'FROM Orde' +
            'rs INNER JOIN "Order Subtotals" ON Orders.OrderID = "Order Subto' +
            'tals".OrderID'#13#10'WHERE Orders.ShippedDate IS NOT NULL'#13#10'--ORDER BY ' +
            'Orders.ShippedDate'#13#10
        end
        item
          ObjectName = 'Summary of Sales by Year'
          CreateImplementation = 
            #13#10'create view "Summary of Sales by Year" AS'#13#10'SELECT Orders.Shipp' +
            'edDate, Orders.OrderID, "Order Subtotals".Subtotal'#13#10'FROM Orders ' +
            'INNER JOIN "Order Subtotals" ON Orders.OrderID = "Order Subtotal' +
            's".OrderID'#13#10'WHERE Orders.ShippedDate IS NOT NULL'#13#10'--ORDER BY Ord' +
            'ers.ShippedDate'#13#10
        end>
    end>
